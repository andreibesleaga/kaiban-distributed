{
  "name": "kaiban-distributed",
  "version": "1.4.0",
  "description": "Kaiban Distributed: Distributed Agentic AI Platform - Actor Model Kanban Framework Implementation with Enterprise Messaging Layer State (Redis/Kafka) and Individual Deployed AI Nodes (TypeScript).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "node dist/src/main/index.js",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:kafka": "vitest run --config vitest.e2e.kafka.config.mts",
    "test:e2e:security": "vitest run --config vitest.e2e.security.config.mts",
    "test:e2e:live": "vitest run --config vitest.e2e.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint:arch": "madge --circular --extensions ts src/",
    "bench": "vitest bench --run --config vitest.bench.config.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreibesleaga/kaiban-distributed.git"
  },
  "keywords": [],
  "author": "Andrei Besleaga",
  "license": "GPL-3.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/andreibesleaga/kaiban-distributed/issues"
  },
  "homepage": "https://github.com/andreibesleaga/kaiban-distributed#readme",
  "overrides": {
    "langsmith": ">=0.7.4",
    "expr-eval": ">=2.0.2",
    "form-data": ">=4.0.6",
    "vite": ">=8.0.16",
    "file-type": ">=16.5.4",
    "@langchain/core": ">=0.3.80",
    "@langchain/community": ">=0.3.59",
    "langchain": ">=0.3.37",
    "axios": ">=1.16.1",
    "protobufjs": ">=7.5.8",
    "@grpc/grpc-js": ">=1.14.4",
    "fast-uri": ">=3.1.2",
    "fast-xml-parser": ">=5.7.0",
    "hono": ">=4.12.23",
    "ws": ">=8.21.0",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1",
    "ip-address": ">=10.2.0",
    "@opentelemetry/exporter-prometheus": ">=0.217.0",
    "postcss": ">=8.4.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.3",
    "fast-check": "^4.8.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.70.4",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "kaibanjs": "^0.23.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
