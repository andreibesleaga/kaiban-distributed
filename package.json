{
  "name": "kaiban-distributed",
  "version": "2.0.2",
  "description": "Kaiban Distributed: Distributed Agentic AI Platform - Actor Model Kanban Framework Implementation with Enterprise Messaging Layer State (Redis/Kafka) and Individual Deployed AI Nodes (TypeScript).",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./shared": {
      "types": "./dist/src/shared/index.d.ts",
      "default": "./dist/src/shared/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE-APACHE",
    "LICENSING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "dev": "node dist/src/main/index.js",
    "dev:gateway": "ROLE=gateway node dist/src/main/index.js",
    "dev:worker": "ROLE=worker node dist/src/main/index.js",
    "lint": "eslint src tests examples --max-warnings 0",
    "lockfile:fix": "sh scripts/fix-lockfile.sh",
    "lockfile:check": "sh scripts/fix-lockfile.sh --check",
    "format": "prettier --write src tests",
    "test": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:kafka": "vitest run --config vitest.e2e.kafka.config.mts",
    "test:e2e:security": "vitest run --config vitest.e2e.security.config.mts",
    "test:e2e:chaos": "vitest run --config vitest.e2e.chaos.config.mts",
    "test:e2e:live": "vitest run --config vitest.e2e.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint:arch": "madge --circular --extensions ts src/",
    "bench": "vitest bench --run --config vitest.bench.config.mts",
    "api:check": "npm run build && api-extractor run --verbose && api-extractor run -c api-extractor.shared.json --verbose",
    "api:update": "npm run build && api-extractor run --local --verbose && api-extractor run -c api-extractor.shared.json --local --verbose",
    "test:mutation": "stryker run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreibesleaga/kaiban-distributed.git"
  },
  "keywords": [],
  "author": "Andrei Besleaga",
  "license": "Apache-2.0",
  "type": "commonjs",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/andreibesleaga/kaiban-distributed/issues"
  },
  "homepage": "https://github.com/andreibesleaga/kaiban-distributed#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "langsmith": ">=0.7.4",
    "expr-eval": ">=2.0.2",
    "form-data": ">=4.0.6",
    "vite": ">=8.1.6",
    "file-type": ">=16.5.4",
    "@langchain/core": ">=1.2.20 <2",
    "@langchain/community": ">=0.3.59",
    "langchain": ">=0.3.37",
    "axios": ">=1.16.1",
    "protobufjs": ">=8.6.6",
    "@grpc/grpc-js": ">=1.14.5",
    "fast-uri": ">=4.1.5 <5",
    "fast-xml-parser": ">=5.7.0",
    "hono": ">=4.13.13",
    "brace-expansion": ">=5.0.12 <6",
    "js-yaml": ">=4.3.2 <5",
    "ws": ">=8.21.0",
    "qs": ">=6.16.0",
    "uuid": ">=11.1.1",
    "ip-address": ">=10.7.4 <11",
    "browserslist": ">=4.28.9 <5",
    "nanoid": ">=3.3.18 <4",
    "socket.io-parser": ">=4.2.7 <5",
    "glob": ">=10.5.0",
    "@opentelemetry/exporter-prometheus": ">=0.217.0",
    "postcss": ">=8.5.25",
    "handlebars": ">=4.7.10 <5",
    "proxy-addr": ">=2.0.8 <3",
    "follow-redirects": ">=1.16.1 <2",
    "source-map-js": ">=1.2.2 <2",
    "fast-copy": ">=4.1.0 <5",
    "body-parser": ">=2.4.0 <3",
    "madge": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "madge": "^8.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@langchain/openai": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bullmq": "^5.80.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "kaibanjs": "0.24.2",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.2.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
